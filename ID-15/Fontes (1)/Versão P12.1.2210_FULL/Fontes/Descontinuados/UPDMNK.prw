	''																		, ; //X6_DEFPOR
	''																		, ; //X6_DEFSPA
	''																		, ; //X6_DEFENG
	''																		} ) //X6_PYME   
	*/

	aAdd( aSX6, { ;
	'  '												    				, ; //X6_FIL
	'MK_VENCINI'   															, ; //X6_VAR
	'N'																		, ; //X6_TIPO
	'Numero de dias a contar da Data de Vencimento dos titulos '			, ; //X6_DESCRIC
	'Numero de dias a contar da Data de Vencimento dos titulos '			, ; //X6_DSCSPA
	'Numero de dias a contar da Data de Vencimento dos titulos '			, ; //X6_DSCENG
