	aAdd( aSX6, { ;
	'  '												    				, ; //X6_FIL
	'MK_TIPPAG'   															, ; //X6_VAR
	'C'																		, ; //X6_TIPO
	'Tipo de Pagamento utilizado para bordero'  	    					, ; //X6_DESCRIC
