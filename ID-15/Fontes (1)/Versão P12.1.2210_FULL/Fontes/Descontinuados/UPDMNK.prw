	'  '												    				, ; //X6_FIL
	'MK_VENCFIM'   															, ; //X6_VAR
	'N'																		, ; //X6_TIPO
	'Numero de dias a contar ate a Data de Vencimento dos titulos '			, ; //X6_DESCRIC
	'Numero de dias a contar ate a Data de Vencimento dos titulos '	    	, ; //X6_DSCSPA
